@using GaleriaArteFrontend.Services
@inject ChatService ChatService
@inject AuthService AuthService
@inject IJSRuntime JSRuntime
@implements IDisposable

<!-- Botón para abrir el chat -->
<div id="chatButton" @onclick="ToggleChat">💬</div>

<!-- Ventana del chat -->
<div id="chatWindow" style="display: @(_isVisible ? "block" : "none")">
    <div id="chatHeader">
        <div class="chat-header-left">
            <span class="chat-title">@(_showPrivateMessages ? "Mensajes Privados" : "Chat Público")</span>
            @if (_isConnected)
            {
                <span class="connection-status connected">●</span>
            }
            else
            {
                <span class="connection-status disconnected">●</span>
            }
        </div>
        <div class="chat-header-actions">
            <button class="btn-toggle-view" @onclick="ToggleView" title="@(_showPrivateMessages ? "Ver chat público" : "Ver mensajes privados")">
                <i class="fas @(_showPrivateMessages ? "fa-comments" : "fa-envelope")"></i>
            </button>
            <span id="closeChat" @onclick="CloseChat">&times;</span>
        </div>
    </div>
    
    @if (_showPrivateMessages)
    {
        <!-- Vista de mensajes privados -->
        <div id="privateMessagesView">
            @if (_selectedConversation == null)
            {
                <!-- Lista de conversaciones -->
                <div class="conversations-list">
                    @if (_conversationUsers.Any())
                    {
                        @foreach (var user in _conversationUsers)
                        {
                            <div class="conversation-item" @onclick="() => SelectConversation(user)">
                                <div class="conversation-avatar">@(user.FirstOrDefault().ToString().ToUpper())</div>
                                <div class="conversation-info">
                                    <span class="conversation-user">@user</span>
                                    <span class="conversation-preview">Toca para ver mensajes</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-conversations">
                            <i class="fas fa-inbox"></i>
                            <p>No tienes conversaciones privadas</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Conversación específica -->
                <div class="conversation-header">
                    <button class="btn-back" @onclick="BackToConversations">
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <span class="conversation-title">@_selectedConversation</span>
                </div>
                <ul class="private-messages-list">
                    @foreach (var message in _selectedConversationMessages.AsEnumerable().Reverse())
                    {
                        var isOwn = message.FromUser == _userName;
                        var cssClass = isOwn ? "private-message own-message" : "private-message other-message";
                        var initial = !string.IsNullOrEmpty(message.FromUser) ? message.FromUser.First().ToString().ToUpper() : "?";
                        var timeString = message.Timestamp.ToString("HH:mm");
                        
                        <li class="@cssClass">
                            <div class="avatar">@initial</div>
                            <div class="bubble">
                                <span class="sender-name">@message.FromUser</span>
                                <div class="message-content">@message.Message</div>
                                <div class="message-time">@timeString</div>
                            </div>
                        </li>
                    }
                </ul>
                <div class="private-chat-footer">
                    <input type="text" @bind="_currentPrivateMessage" @onkeypress="HandlePrivateKeyPress" placeholder="Escribe un mensaje privado..." />
                    <button type="button" @onclick="SendPrivateMessage" disabled="@_isSendingPrivateMessage">
                        @if (_isSendingPrivateMessage)
                        {
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <span>Enviar</span>
                        }
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Vista de chat público -->
        <ul id="chatMessages">
            @foreach (var message in _messages.AsEnumerable().Reverse())
            {
                var isOwn = message.Name == _userName;
                var cssClass = isOwn ? "chat-message own-message" : "chat-message other-message";
                var initial = !string.IsNullOrEmpty(message.Name) ? message.Name.First().ToString().ToUpper() : "?";
                var timeString = message.Timestamp.ToString("HH:mm");
                
                <li class="@cssClass">
                    <div class="avatar">@initial</div>
                    <div class="bubble">
                        <span class="sender-name">@message.Name</span>
                        <div class="message-content">@message.Message</div>
                        <div class="message-time">@timeString</div>
                    </div>
                </li>
            }
        </ul>
        <div id="chatFooter">
            <input type="text" id="userName" @bind="_userName" readonly />
            <input type="text" id="messageInput" @bind="_currentMessage" @onkeypress="HandleKeyPress" placeholder="Escribe un mensaje..." />
            <button type="button" id="sendMessage" @onclick="SendMessage" disabled="@_isSendingMessage">
                @if (_isSendingMessage)
                {
                    <span>Enviando...</span>
                }
                else
                {
                    <span>Enviar</span>
                }
            </button>
        </div>
    }
</div>

<style>
    #chatButton {
        position: fixed;
        bottom: 24px;
        left: 24px;
        background: linear-gradient(135deg, #4a90e2 60%, #357ab8 100%);
        color: white;
        padding: 14px 18px;
        border-radius: 50%;
        cursor: pointer;
        z-index: 1000;
        font-size: 22px;
        box-shadow: 0 4px 16px rgba(74,144,226,0.18);
        transition: background 0.2s;
    }

    #chatButton:hover {
        background: linear-gradient(135deg, #357ab8 60%, #4a90e2 100%);
    }

    #chatWindow {
        position: fixed;
        bottom: 90px;
        left: 24px;
        width: 350px;
        background: #fff;
        border: none;
        border-radius: 16px;
        padding: 0;
        z-index: 1000;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18);
        overflow: hidden;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    #chatHeader {
        background: linear-gradient(135deg, #4a90e2 60%, #357ab8 100%);
        color: #fff;
        padding: 14px 18px;
        font-weight: bold;
        font-size: 17px;
        letter-spacing: 1px;
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chat-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .chat-title {
        font-size: 16px;
    }

    .chat-header-actions {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .btn-toggle-view {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        border-radius: 6px;
        padding: 8px 10px;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.3s ease;
        min-width: 36px;
        height: 32px;
