</style>

@code {
    private ObraCrearModel obra = new();
    private IBrowserFile? selectedFile;
    private string? fileError;
    private string? successMessage;
    private string? errorMessage;
    private bool isSubmitting = false;
    private EditContext? editContext;

    protected override void OnInitialized()
    {
        editContext = new EditContext(obra);
    }

    private bool HasValidationError(string fieldName)
    {
        return editContext?.GetValidationMessages(editContext.Field(fieldName)).Any() ?? false;
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        fileError = null;
        var file = e.File;
        
        if (file == null)
        {
            selectedFile = null;
            return;
        }

        // Validar tamaño (5MB máximo)
        if (file.Size > 5 * 1024 * 1024)
        {
            fileError = "El archivo es demasiado grande. Máximo 5MB.";
            selectedFile = null;
            return;
        }

        // Validar tipo de archivo
        var ext = Path.GetExtension(file.Name).ToLower();
        if (ext != ".jpg" && ext != ".jpeg" && ext != ".png")
        {
            fileError = "Solo se permiten archivos JPG, JPEG o PNG.";
            selectedFile = null;
            return;
        }

        selectedFile = file;
        StateHasChanged();
    }

    private void RemoveFile()
    {
        selectedFile = null;
        fileError = null;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (selectedFile == null)
        {
            fileError = "Debes seleccionar una imagen para tu obra.";
            return;
        }

        errorMessage = null;
        successMessage = null;
        isSubmitting = true;
        StateHasChanged();

        try
        {
            var result = await ObrasService.CrearObraAsync(obra, selectedFile);
            if (result)
            {
                successMessage = "¡Obra publicada exitosamente! Redirigiendo...";
                StateHasChanged();
                
                // Esperar un momento para mostrar el mensaje y luego redirigir
                await Task.Delay(1500);
                Navigation.NavigateTo("/artista/panel");
            }
            else
            {
                errorMessage = "No se pudo publicar la obra. Inténtalo nuevamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al subir la obra: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task VolverAlPanel()
    {
        // Verificar si hay cambios sin guardar
        if (!string.IsNullOrEmpty(obra.Titulo) || !string.IsNullOrEmpty(obra.Descripcion) || obra.Precio > 0 || selectedFile != null)
        {
            var confirmar = await JSRuntime.InvokeAsync<bool>("confirm", 
                "¿Estás seguro de que deseas salir? Los cambios no guardados se perderán.");
            
            if (!confirmar) return;
        }
        
        Navigation.NavigateTo("/artista/panel");
    }

    public class ObraCrearModel
    {
        [Required(ErrorMessage = "El título es obligatorio")]
        [StringLength(200, ErrorMessage = "El título no puede exceder 200 caracteres")]
        public string Titulo { get; set; } = string.Empty;

        [StringLength(1000, ErrorMessage = "La descripción no puede exceder 1000 caracteres")]
        public string? Descripcion { get; set; }

        [Required(ErrorMessage = "El precio es obligatorio")]
        [Range(0, double.MaxValue, ErrorMessage = "El precio debe ser mayor o igual a 0")]
        public decimal Precio { get; set; }
    }
}
