@page "/artista/crear-obra"
@using GaleriaArteFrontend.Models
@using System.IO
@using GaleriaArteFrontend.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject GaleriaArteFrontend.Services.ObrasService ObrasService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Nueva Obra - Galería de Arte</PageTitle>

<AuthGuard RolRequerido="9a66346f-164e-4ce2-8e5b-568b8f643799">
    <div class="crear-obra-container">
        <div class="container-fluid">
            <!-- Header -->
            <div class="page-header">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <button class="btn-back" @onclick="VolverAlPanel">
                            <i class="fas fa-arrow-left"></i>
                            Volver al Panel
                        </button>
                        <h1 class="page-title">
                            <i class="fas fa-plus-circle"></i>
                            Nueva Obra de Arte
                        </h1>
                        <p class="page-subtitle">Comparte tu creatividad con el mundo</p>
                    </div>
                    <div class="col-md-4 text-end">
                        <div class="header-icon">
                            <i class="fas fa-paint-brush"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Formulario -->
            <div class="form-container">
                <div class="row justify-content-center">
                    <div class="col-lg-8 col-xl-6">
                        <div class="form-card">
                            <EditForm Model="obra" OnValidSubmit="HandleValidSubmit">
                                <DataAnnotationsValidator />
                                
                                <!-- Título -->
                                <div class="form-group">
                                    <label for="titulo" class="form-label">
                                        <i class="fas fa-heading"></i>
                                        Título de la Obra
                                    </label>
                                    <InputText id="titulo" class="@($"form-control {(HasValidationError("Titulo") ? "is-invalid" : "")}")" 
                                              @bind-Value="obra.Titulo" placeholder="Escribe el título de tu obra..." />
                                    <ValidationMessage For="@(() => obra.Titulo)" class="invalid-feedback" />
                                </div>

                                <!-- Descripción -->
                                <div class="form-group">
                                    <label for="descripcion" class="form-label">
                                        <i class="fas fa-align-left"></i>
                                        Descripción
                                    </label>
                                    <InputTextArea id="descripcion" class="@($"form-control description-textarea {(HasValidationError("Descripcion") ? "is-invalid" : "")}")" 
                                                  @bind-Value="obra.Descripcion" placeholder="Describe tu obra, técnica utilizada, inspiración..." rows="4" />
                                    <small class="form-text">Comparte la historia detrás de tu creación</small>
                                    <ValidationMessage For="@(() => obra.Descripcion)" class="invalid-feedback" />
                                </div>

                                <!-- Precio -->
                                <div class="form-group">
                                    <label for="precio" class="form-label">
                                        <i class="fas fa-dollar-sign"></i>
                                        Precio (COP)
                                    </label>
                                    <div class="price-input-container">
                                        <span class="price-symbol">$</span>
                                        <InputNumber id="precio" class="@($"form-control price-input {(HasValidationError("Precio") ? "is-invalid" : "")}")" 
                                                    @bind-Value="obra.Precio" placeholder="0" min="0" step="1000" />
                                    </div>
                                    <small class="form-text">Establece un precio justo para tu obra</small>
                                    <ValidationMessage For="@(() => obra.Precio)" class="invalid-feedback" />
                                </div>

                                <!-- Imagen -->
                                <div class="form-group">
                                    <label for="archivo" class="form-label">
                                        <i class="fas fa-image"></i>
                                        Imagen de la Obra
                                    </label>
                                    <div class="file-upload-container">
                                        <div class="file-upload-area @(selectedFile != null ? "has-file" : "") @(!string.IsNullOrEmpty(fileError) ? "has-error" : "")">
                                            <InputFile id="archivo" OnChange="OnInputFileChange" accept=".jpg,.jpeg,.png" class="file-input" />
                                            <div class="file-upload-content">
                                                @if (selectedFile == null)
                                                {
                                                    <div class="upload-icon">
                                                        <i class="fas fa-cloud-upload-alt"></i>
                                                    </div>
                                                    <h5>Arrastra tu imagen aquí</h5>
                                                    <p>o <strong>haz clic para seleccionar</strong></p>
                                                    <small>JPG, JPEG o PNG • Máximo 5MB</small>
                                                }
                                                else
                                                {
                                                    <div class="file-success">
                                                        <i class="fas fa-check-circle"></i>
                                                        <span>@selectedFile.Name</span>
                                                        <button type="button" class="btn-remove-file" @onclick="RemoveFile">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(fileError))
                                        {
                                            <div class="file-error">
                                                <i class="fas fa-exclamation-triangle"></i>
                                                @fileError
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Botones de Acción -->
                                <div class="form-actions">
                                    <button type="button" class="btn btn-outline-secondary btn-cancel" @onclick="VolverAlPanel">
                                        <i class="fas fa-times"></i>
                                        Cancelar
                                    </button>
                                    <button type="submit" class="btn btn-primary btn-submit" disabled="@isSubmitting">
                                        @if (isSubmitting)
                                        {
                                            <i class="fas fa-spinner fa-spin"></i>
                                            <span>Subiendo...</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-upload"></i>
                                            <span>Publicar Obra</span>
                                        }
                                    </button>
                                </div>

                                <!-- Mensajes -->
                                @if (!string.IsNullOrEmpty(successMessage))
                                {
                                    <div class="alert alert-success">
                                        <i class="fas fa-check-circle"></i>
                                        @successMessage
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <div class="alert alert-danger">
                                        <i class="fas fa-exclamation-circle"></i>
                                        @errorMessage
                                    </div>
                                }
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</AuthGuard>

