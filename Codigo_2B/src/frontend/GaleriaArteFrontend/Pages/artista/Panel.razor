@page "/artista/panel"
@using GaleriaArteFrontend.Models
@using GaleriaArteFrontend.Components
@inject NavigationManager Navigation
@inject GaleriaArteFrontend.Services.ObrasService ObrasService
@inject IJSRuntime JS

<AuthGuard RolRequerido="9a66346f-164e-4ce2-8e5b-568b8f643799">
    <div class="panel-container">
        <div class="panel-header">
            <div class="header-content">
                <h1><i class="fas fa-palette"></i> Panel de Artista</h1>
                <p>Gestiona tu galería de obras de arte</p>
            </div>
            <button class="btn-create-obra" @onclick="SubirObra">
                <i class="fas fa-plus"></i>
                Nueva Obra
            </button>
        </div>

        <div class="panel-body">
            @if (obras == null)
            {
                <div class="loading-container">
                    <div class="loading-spinner"></div>
                    <p>Cargando tus obras...</p>
                </div>
            }
            else if (!obras.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-image"></i>
                    <h3>No tienes obras registradas</h3>
                    <p>Comienza subiendo tu primera obra de arte</p>
                    <button class="btn-primary" @onclick="SubirObra">
                        <i class="fas fa-upload"></i>
                        Subir Primera Obra
                    </button>
                </div>
            }
            else
            {
                <div class="obras-grid">
                    @foreach (var obra in obras)
                    {
                        <div class="obra-card @(obra.Estado == "activa" ? "active" : obra.Estado == "vendida" ? "sold" : "hidden")">
                            <div class="obra-image">
                                @if (!string.IsNullOrEmpty(obra.ArchivoBase64))
                                {
                                    <img src="@($"data:image/jpeg;base64,{obra.ArchivoBase64}")" alt="@obra.Titulo" />
                                }
                                else
                                {
                                    <div class="no-image">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }
                                <div class="status-badge @obra.Estado.ToLower()">
                                    @(obra.Estado == "activa" ? "ACTIVA" : obra.Estado == "vendida" ? "VENDIDA" : "OCULTA")
                                </div>
                            </div>
                            
                            <div class="obra-content">
                                <h4>@obra.Titulo</h4>
                                <p class="description">@(string.IsNullOrEmpty(obra.Descripcion) ? "Sin descripción" : obra.Descripcion)</p>
                                <div class="obra-details">
                                    <span class="price">@obra.Precio.ToString("C")</span>
                                    <span class="date">@obra.FechaPublicacion.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            
                            <div class="obra-actions">
                                <button class="btn-edit" @onclick="() => EditarObra(obra.Id)" title="Editar obra">
                                    <i class="fas fa-edit"></i>
                                </button>
                                
                                @if (obra.Estado == "activa")
                                {
                                    <button class="btn-hide" @onclick="async () => await CambiarEstadoObra(obra.Id, false)" title="Ocultar obra">
                                        <i class="fas fa-eye-slash"></i>
                                    </button>
                                }
                                else if (obra.Estado == "oculta")
                                {
                                    <button class="btn-show" @onclick="async () => await CambiarEstadoObra(obra.Id, true)" title="Activar obra">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn-delete" @onclick="async () => await EliminarObra(obra.Id)" title="Eliminar obra">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</AuthGuard>

<style>
    .panel-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .panel-header {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 30px;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
    }

    .header-content h1 {
        margin: 0;
        color: #2d3748;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .header-content p {
        margin: 5px 0 0 0;
        color: #718096;
        font-size: 16px;
    }

    .btn-create-obra {
        background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-create-obra:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(72, 187, 120, 0.3);
    }

    .panel-body {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
    }

    .loading-container {
        text-align: center;
        padding: 60px 20px;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #e2e8f0;
        border-top: 4px solid #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #4a5568;
    }

    .empty-state i {
        font-size: 80px;
        color: #cbd5e0;
        margin-bottom: 20px;
    }

    .empty-state h3 {
        font-size: 24px;
        margin: 20px 0 10px;
        color: #2d3748;
    }

    .empty-state p {
        font-size: 16px;
        color: #718096;
        margin-bottom: 30px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
    }

    .obras-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .obra-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        position: relative;
    }

    .obra-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .obra-card.hidden {
        opacity: 0.7;
        border: 2px dashed #cbd5e0;
    }

    .obra-card.sold {
        border: 2px solid #f6ad55;
    }

    .obra-image {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

    .obra-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .obra-card:hover .obra-image img {
        transform: scale(1.05);
    }

    .no-image {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        color: #a0aec0;
    }

    .status-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .status-badge.activa {
        background: #48bb78;
        color: white;
    }

    .status-badge.oculta {
        background: #a0aec0;
        color: white;
    }

    .status-badge.vendida {
        background: #f6ad55;
        color: white;
    }

    .obra-content {
        padding: 20px;
    }

    .obra-content h4 {
        margin: 0 0 8px 0;
        font-size: 18px;
        font-weight: 600;
        color: #2d3748;
        line-height: 1.3;
    }

    .description {
        color: #718096;
        font-size: 14px;
        margin-bottom: 15px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .obra-details {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .price {
        font-size: 18px;
        font-weight: 700;
        color: #38a169;
    }

    .date {
        font-size: 12px;
        color: #a0aec0;
    }

    .obra-actions {
        padding: 15px 20px;
        background: #f7fafc;
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .obra-actions button {
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .btn-edit {
        background: linear-gradient(135deg, #4299e1 0%, #3182ce 100%);
        color: white;
    }

    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(66, 153, 225, 0.3);
    }

    .btn-hide {
        background: linear-gradient(135deg, #ed8936 0%, #dd6b20 100%);
        color: white;
    }

    .btn-hide:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(237, 137, 54, 0.3);
    }

    .btn-show {
        background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        color: white;
    }

    .btn-show:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(72, 187, 120, 0.3);
    }

    .btn-delete {
        background: linear-gradient(135deg, #f56565 0%, #e53e3e 100%);
        color: white;
    }

    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(245, 101, 101, 0.3);
    }

    @@media (max-width: 768px) {
        .panel-header {
            flex-direction: column;
            gap: 20px;
            text-align: center;
        }
        
        .obras-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<Obra> obras;

    protected override async Task OnInitializedAsync()
    {
        obras = await ObrasService.GetObrasAsync();
    }

    private void EditarObra(int id)
    {
        Navigation.NavigateTo($"/artista/editar-obra/{id}");
    }

    private void SubirObra()
    {
        Navigation.NavigateTo("/artista/crear-obra");
    }

    private async Task CambiarEstadoObra(int id, bool activar)
    {
        string mensaje = activar
            ? "¿Estás seguro de que deseas activar esta obra?"
            : "¿Estás seguro de que deseas ocultar esta obra?";
        var confirm = await JS.InvokeAsync<bool>("confirm", mensaje);
        if (!confirm) return;
        bool result;
        if (activar)
            result = await ObrasService.ActivarObraAsync(id);
        else
            result = await ObrasService.OcultarObraAsync(id);
        if (result)
        {
            obras = await ObrasService.GetObrasAsync();
            StateHasChanged();
        }
    }

    private async Task EliminarObra(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar esta obra? Esta acción no se puede deshacer.");
        if (!confirm) return;
        var result = await ObrasService.EliminarObraAsync(id);
        if (result)
        {
            obras = await ObrasService.GetObrasAsync();
            StateHasChanged();
        }
    }
}
