{
  "ApiSettings": {
    "MensajeriaUrl": "https://api.galeriaartefrontend.com/mensajeria",
    "GatewayUrl": "https://api.galeriaartefrontend.com",
    "UsuariosUrl": "https://api.galeriaartefrontend.com/usuarios",
    "ObrasUrl": "https://api.galeriaartefrontend.com/obras"
  },
  "SignalR": {
    "HubUrl": "/mensajeriahub",
    "ReconnectAttempts": 10,
    "ReconnectInterval": 5000
  },
  "Mensajeria": {
    "SonidoNotificacion": true,
    "NotificacionesPush": true,
    "MensajesPorPagina": 50,
    "IntervaloVerificacionMensajes": 60000,
    "TiempoEscribiendo": 3000
  },
  "UI": {
    "TemaOscuro": false,
    "AnimacionesHabilitadas": true,
    "ChatFlotanteHabilitado": true,
    "NotificacionesToast": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "GaleriaArteFrontend.Services.MensajeriaService": "Information"
    }
  }
}
